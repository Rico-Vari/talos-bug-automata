    "diff_hunk": "@@ -31,11 +31,17 @@ def daily_agenda(utc_slots: list[datetime], tz_name: str) -> dict[str, list[str]\n \n     Returns {\"YYYY-MM-DD\": [\"HH:MM\", ...]} with the days and times the\n     user expects to see in their own time zone.\n+\n+    Slots must be timezone-aware datetimes. Both the day key and the time\n+    come from the same local conversion: grouping by the UTC date moves the\n+    slot to the neighbouring cell whenever the UTC date and the local one\n+    differ — to the next day west of UTC, to the previous one east of\n+    it.\n     \"\"\"\n     agenda: dict[str, list[str]] = {}\n     for slot in utc_slots:\n-        day = slot.strftime(\"%Y-%m-%d\")\n-        agenda.setdefault(day, []).append(to_local(slot, tz_name).strftime(\"%H:%M\"))\n+        local = to_local(slot, tz_name)",
